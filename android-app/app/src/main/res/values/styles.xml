<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The light half of the pair. values-night defines the same style with the
      dark platform theme as its parent, which is how the app follows the
      phone's own setting without an AppCompat dependency.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <!-- Dialogs inherit the platform accent by default (teal in the dark
             theme); the app's own blue is what every other control uses. -->
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
        <item name="android:colorControlActivated">@color/accent</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>

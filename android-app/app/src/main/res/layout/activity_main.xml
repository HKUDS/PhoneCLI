<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header: who you are talking to, and the two things you rarely need. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/maps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:text="@string/maps"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:text="@string/usage"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip"
            android:text="@string/settings"
            android:textColor="@color/ink_soft"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- Not a redundant wrapper: every bubble is appended here by id, and
             it has to sit inside the ScrollView as one growing child. -->
        <LinearLayout
            android:id="@+id/messages"
            tools:ignore="UselessParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="18dp">

                <!-- 40dp rather than 56: the mark is decoration, and it was
                     pushing the examples a third of the screen down. -->
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="@string/agent_mark"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/welcome_title"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/welcome_hint"
                    android:textColor="@color/ink_soft"
                    android:textSize="12.5sp" />

                <!-- Two columns: stacked vertically they took three rows of the
                     screen for three examples. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/chip1"
                        style="@style/Chip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/chip_wlan" />

                    <TextView
                        android:id="@+id/chip2"
                        style="@style/Chip"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:text="@string/chip_weather" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chip3"
                    style="@style/Chip"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/chip_bluetooth" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/frameCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/frameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/ink_soft"
            android:text="@string/frame_label" />

        <ImageView
            android:id="@+id/frame"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:background="@color/bg"
            android:contentDescription="@string/frame"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/running"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/cancel"
            android:textColor="@color/err"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="4dp"
        android:paddingBottom="14dp">

        <EditText
            android:id="@+id/input"
                android:importantForAutofill="no"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_soft"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/mode_auto"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_send"
            android:contentDescription="@string/send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

<!-- The agent's screen, floating over this app only.
     A system overlay needs SYSTEM_ALERT_WINDOW and MIUI force-hides those after
     every install (mForceHideNonSystemOverlayWindow=true); a plain view inside
     this window cannot be hidden that way. -->
<LinearLayout
    android:id="@+id/capsule"
    android:layout_width="96dp"
    android:layout_height="200dp"
    android:layout_gravity="top|end"
    android:layout_marginTop="92dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:background="@drawable/bg_capsule"
    android:elevation="8dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/capsuleFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        android:contentDescription="@string/capsule" />

    <!-- Collapsed state: one dot, still draggable, one tap brings it back. -->
    <TextView
        android:id="@+id/capsuleDot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/dot_filled"
        android:textSize="18sp"
        android:textColor="#44CC88"
        android:visibility="gone" />

    <TextView
        android:id="@+id/capsuleLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="@color/ink_soft"
        android:text="@string/capsule" />
</LinearLayout>

</FrameLayout>
